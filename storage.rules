rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Private files per authenticated tattoo master.
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
